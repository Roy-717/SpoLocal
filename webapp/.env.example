# SpoLocal — copy to .env and fill in values as needed.
# Spotify credentials are NO LONGER REQUIRED — metadata is fetched from embed pages.

# Parallel download workers (default 2). Each downloads a different track simultaneously. Max 8.
# SPOLOCAL_DOWNLOAD_WORKERS=2

# Optional: pause N seconds after each download job. Try 1-2 if downloads seem flaky.
# SPOLOCAL_DOWNLOAD_DELAY_SEC=0

# Optional: when opening Lyrics and nothing is on disk / tags, query LRCLIB once (default: on). Set 0 to disable.
# SPOLOCAL_LYRICS_ON_DEMAND=1

# Optional: set to 0/false/off to skip LRCLIB search after download (default: search on)
# SPOLOCAL_FETCH_LYRICS_ON_DOWNLOAD=1

# Optional compatibility aliases (legacy):
# SPRITY_DOWNLOAD_WORKERS=2
# SPRITY_DOWNLOAD_DELAY_SEC=0
# SPRITY_LYRICS_ON_DEMAND=1
# SPRITY_FETCH_LYRICS_ON_DOWNLOAD=1

# Optional override for LRCLIB User-Agent.
# SPOLOCAL_LRCLIB_USER_AGENT=SpoLocal lyrics (local downloader)
